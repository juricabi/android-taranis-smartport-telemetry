<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/settingsBackground</item>
        <item name="android:colorBackground">@color/settingsBackground</item>
        <item name="colorControlActivated">@color/settingsAccent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>


    <!-- Toolbar contents are dark, because the bar itself is light grey. -->
    <style name="ToolbarTheme" parent="@style/ThemeOverlay.AppCompat.Light"/>

</resources>
