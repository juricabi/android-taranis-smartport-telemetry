<?xml version="1.0" encoding="utf-8"?>
<!--
    Connection settings for network telemetry.

    No background colour and no hardcoded text colours anywhere in here: the
    dialog inherits them from AppTheme, which is what makes it legible in both
    light and night mode. The map overlay layouts in this project do hardcode
    white, deliberately, and copying a row from one of those into a dialog gives
    white on white in the light theme.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/network_preset"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <Spinner
                android:id="@+id/network_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/network_interface"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <Spinner
                android:id="@+id/network_interface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        <TextView
                android:id="@+id/network_wifi_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/network_transport"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <Spinner
                android:id="@+id/network_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        <TextView
                android:id="@+id/network_host_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/network_host"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <EditText
                    android:id="@+id/network_host"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/network_host_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"/>

            <Button
                    android:id="@+id/network_find"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/network_find"/>
        </LinearLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/network_port"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

        <EditText
                android:id="@+id/network_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1"
                android:singleLine="true"/>

        <TextView
                android:id="@+id/network_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp"/>

    </LinearLayout>
</ScrollView>
