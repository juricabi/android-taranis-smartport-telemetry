<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp">

        <RadioGroup
            android:id="@+id/video_settings_source"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/video_settings_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Off" />

            <RadioButton
                android:id="@+id/video_settings_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="USB camera (UVC)" />

            <RadioButton
                android:id="@+id/video_settings_network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network stream (rtsp, udp or http)" />

        </RadioGroup>

        <!-- shown only when Network is the chosen source -->
        <LinearLayout
            android:id="@+id/video_settings_address_group"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">

            <EditText
                android:id="@+id/video_settings_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:hint="rtsp://  http://  udp://" />

            <TextView
                android:id="@+id/video_settings_recents_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textStyle="bold"
                android:text="Recent — tap to use" />

            <!-- the rows are added in code: one per remembered address -->
            <LinearLayout
                android:id="@+id/video_settings_recents"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider" />

            <!-- RTSP RTP transport, at the foot of the network settings it
                 belongs to; hidden with them when the source is not a stream -->
            <Switch
                android:id="@+id/video_settings_rtsp_udp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="RTSP over UDP — lower latency, smears on a weak link. Off = TCP (steadier)." />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
