<?xml version="1.0" encoding="utf-8"?>
<!-- One recording. Fixed height, so it is the same size whether or not the
     checkbox shows; the name sits hard left in both modes because the checkbox
     lives on the right and never pushes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="20dp"
    android:paddingRight="12dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/log_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/log_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/log_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_marginLeft="24dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
