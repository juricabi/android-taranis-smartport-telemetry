<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent" android:layout_height="match_parent">

    <FrameLayout
            android:id="@+id/map_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/play_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_alignParentBottom="true"
                android:src="@drawable/ic_play"
                android:visibility="gone"
                app:fabSize="mini"
                tools:visibility="visible"
                    app:backgroundTint="@color/colorAccent" />

        <SeekBar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="8dp"
                android:layout_toEndOf="@+id/play_button"
                android:layout_toStartOf="@+id/buttons_box"
                android:layout_toLeftOf="@+id/buttons_box"
                android:thumb="@drawable/ic_thumb"
                android:visibility="visible" />

        <juricabi.com.telemetry.ui.TextViewOutline
                android:id="@+id/statustext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@id/mode"
                android:layout_toLeftOf="@+id/buttons_box"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="-12dp"
                android:ellipsize="end"
                android:gravity="left"
                android:text="Ready"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:outlineColor="@android:color/black"
                app:outlineSize="3dp" />

        <juricabi.com.telemetry.ui.TextViewOutline
                android:id="@+id/mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignWithParentIfMissing="true"
                android:layout_above="@id/seekbar"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:gravity="left"
                android:lines="1"
                android:text="Disconnected"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:outlineColor="@android:color/black"
                app:outlineSize="3dp" />

        <juricabi.com.telemetry.ui.HorizonView
                android:id="@+id/horizon_view"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_alignParentTop="true"
                android:layout_margin="8dp" />

        <juricabi.com.telemetry.ui.TextViewOutline
                android:id="@+id/clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:text="00:00:00"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"
                app:outlineColor="@android:color/black"
                app:outlineSize="3dp" />

        <juricabi.com.telemetry.ui.LoadingGrid
                android:id="@+id/loading_grid"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_below="@+id/compass_heading"
                android:layout_alignEnd="@+id/compass_heading"
                android:layout_alignRight="@+id/compass_heading"
                android:layout_marginTop="6dp"/>

        <juricabi.com.telemetry.ui.TextViewOutline
                android:id="@+id/compass_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:layout_toLeftOf="@+id/buttons_box"
                android:layout_toStartOf="@+id/buttons_box"
                android:text="↑ 000°"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:outlineColor="@android:color/black"
                app:outlineSize="3dp" />

        <com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/buttons_box"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                app:alignContent="flex_start"
                app:alignItems="flex_start"
                app:justifyContent="flex_start"
                app:flexDirection="column_reverse"
                app:flexWrap="wrap_reverse">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/find_quad_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_find_quad"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/map_type_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_layers"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/follow_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_follow"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/chase_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_chase"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/my_location_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_my_location"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/north_up_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_compass"
                    app:fabSize="mini"
                    app:backgroundTint="@color/colorAccent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/replay_menu_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_menu"
                    android:visibility="gone"
                    app:fabSize="mini"
                    tools:visibility="visible"
                    app:backgroundTint="@color/colorAccent" />

        </com.google.android.flexbox.FlexboxLayout>

    </RelativeLayout>

</FrameLayout>