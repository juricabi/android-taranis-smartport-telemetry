<!-- The grip on the seam between picture and map: only a small pill, the
     rest transparent — the band costs no screen, it floats over the two
     halves meeting edge to edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="28dp"
        android:height="6dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="3dp"/>
            <solid android:color="#99FFFFFF"/>
        </shape>
    </item>
</layer-list>
