<!--
    A fixed wing model, nose up, for anyone flying a plane or a wing rather
    than a quad.

    Same box, same weight and the same nose-up convention as ic_plane (which,
    despite the name, draws a quad), since the map turns whichever is chosen by
    the same heading and they have to read alike at map size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="18dp"
        android:height="18dp"
        android:viewportWidth="24.0"
        android:viewportHeight="24.0">
    <!-- fuselage, nose to tail -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,1.5L13.4,6.5L13.4,20L10.6,20L10.6,6.5Z"/>
    <!-- main wing, swept back -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,8.5L22.5,14.5L22.5,16.5L12,13.5L1.5,16.5L1.5,14.5Z"/>
    <!-- tailplane -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,17.5L17.5,20.5L17.5,22L12,20.5L6.5,22L6.5,20.5Z"/>
</vector>
