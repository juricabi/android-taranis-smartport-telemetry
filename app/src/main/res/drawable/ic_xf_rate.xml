<!--
    "CRSF RATE", shown when the transmitter identifies itself as a Crossfire or
    a Tracer in its CRSF DEVICE_INFO frame.

    Same grid as ic_ghst_rate: 240x240, stroke width 9, wordmark on the top row
    (y 30..90) and RATE beneath (y 130..190), four 40 wide columns at x 20, 73,
    126 and 179 — so the three marks read as one family.

    It earns its place because mode 2 is 150Hz here and 50Hz on ExpressLRS: the
    icon is what says which table the number on screen came from.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <path
        android:name="C"
        android:strokeColor="#fff"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M60,30 L20,30 L20,90 L60,90"/>
    <path
        android:name="R"
        android:strokeColor="#fff"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M73,90 L73,30 L113,30 L113,60 L73,60 M91,60 L113,90"/>
    <path
        android:name="S"
