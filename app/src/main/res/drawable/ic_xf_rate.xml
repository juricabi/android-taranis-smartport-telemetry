        android:strokeLineJoin="round"
        android:pathData="M166,30 L126,30 L126,60 L166,60 L166,90 L126,90"/>
    <path
        android:name="F"
        android:strokeColor="#fff"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M179,90 L179,30 L219,30 M179,60 L207,60"/>

    <path
        android:name="R2"
        android:strokeColor="#fff"
        android:strokeWidth="9"
