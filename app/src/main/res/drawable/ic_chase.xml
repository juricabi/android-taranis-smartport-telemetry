<!--
    The chase camera: the model seen from behind, going away from you, with the
    view fanning out to it from below. Drawn in the same weight as the other
    buttons down the side of the map.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24.0"
        android:viewportHeight="24.0">
    <!-- the aircraft, nose away -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2.5L18.2,12.2L12,9.6L5.8,12.2Z"/>
    <!-- the view it is being watched from -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.75"
        android:pathData="M12,13.4L20,21.5L4,21.5Z"/>
</vector>
