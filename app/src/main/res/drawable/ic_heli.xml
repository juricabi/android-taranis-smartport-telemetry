<!--
    A helicopter, nose up: two crossed rotor blades over a slim fuselage, the
    boom running down to the tail rotor on its end.

    The fuselage and boom are one path: drawn separately, the translucent
    outline underneath double-painted their seam and drew a dark bar across
    the joint. The tail rotor sits centred, the way map silhouettes draw it.
    Same box, same weight and the same nose-up convention as ic_plane and
    ic_fixedwing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="22dp"
        android:height="22dp"
        android:viewportWidth="24.0"
        android:viewportHeight="24.0">
    <!-- main rotor blades, crossed through the mast -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M5.0,3.0L6.0,2.0L19.0,15.0L18.0,16.0Z"/>
    <path
        android:fillColor="#FF000000"
        android:pathData="M5.0,15.0L6.0,16.0L19.0,3.0L18.0,2.0Z"/>
    <!-- fuselage and boom, one shape from nose to tail -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,3.6L9.7,6.4L9.4,10.0L10.5,13.0L11.1,13.0L11.1,19.0L12.9,19.0L12.9,13.0L13.5,13.0L14.6,10.0L14.3,6.4Z"/>
    <!-- the tail rotor -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,20.2m-2.6,0a2.6,2.6 0,1 1,5.2 0a2.6,2.6 0,1 1,-5.2 0"/>
</vector>
