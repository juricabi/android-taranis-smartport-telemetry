<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Asked for so the recording can go on hearing where the phone is while
         the app is away, which is most of a flight. Granted from the system's
         own settings, not from a dialog: the choice is "Allow all the time". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- A development permission, never prompted for: Developer options →
         Select mock location app lists only apps that ask for it, and being
         picked there is the whole grant. Lets the decoded drone GPS be
         republished as the phone's own position, for tracker apps to
         broadcast. The lint rule wants this in a debug manifest, but the
         feature is for the field, which flies the release build. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION"
                     tools:ignore="MockLocation,ProtectedPermissions"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- A normal compass sensor may stop delivering samples after the screen
         sleeps. Held only by the connected foreground service, and only while
         Background compass is enabled. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Network telemetry. ACCESS_WIFI_STATE to find the Wi-Fi network and pin
         the sockets to it, so a transmitter access point with no internet does
         not get bypassed in favour of mobile data. CHANGE_WIFI_MULTICAST_STATE
         to hold a multicast lock, because an ExpressLRS backpack broadcasts its
         telemetry rather than addressing the phone, and Wi-Fi power saving
         filters broadcast frames without one. Both are install time
         permissions and neither prompts the user. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>

    <!-- The UVC video library asks for far more than this app uses of it:
         all-files management, audio recording. Neither is wanted for drawing
         a USB receiver's picture, so neither is inherited. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <!-- Camera is not about the phone's own camera here: since Android 10
         the system hands a camera-class USB device only to a holder of this
         permission, and without it refuses the USB ask instantly, showing
         nothing. Stripping it read in the field as "refused, and it never
         asks again", surviving replugs and reinstalls alike. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- ...and CAMERA alone would imply the phone's own camera is required;
         it is not — the permission serves USB cameras only -->
    <uses-feature
            android:name="android.hardware.camera"
            android:required="false"/>

    <uses-feature
            android:name="android.hardware.bluetooth_le"
            android:required="false"/>
    <!-- The video library marks USB host required, which would bar phones
         without OTG from installing an app that is first a telemetry viewer.
         A phone with no USB host still has the Bluetooth and network links,
         and RTSP video. tools:replace, because the merger ORs "required" and
         the library's true would quietly win otherwise. -->
    <uses-feature
            android:name="android.hardware.usb.host"
            android:required="false"
            tools:replace="android:required"/>

    <!-- largeHeap: the 3D ground streams full-screen imagery — the mosaics
         mid-assembly and the upload queue legitimately hold north of a
         hundred megabytes of bitmaps, and the stock 256MB limit died of a
         48-byte allocation over Velebit. -->
    <application
            android:largeHeap="true"
            android:usesCleartextTraffic="true"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/AppTheme">


        <!-- singleTask, not singleInstance: there is still ever one map, and
             a USB plug-in still lands on it, but Settings may share its task.
             Alone in its own task, Settings was where the launcher icon led
             after Home, and back from there went home - the map was
             unreachable. -->
        <activity
                android:launchMode="singleTask"
                android:name=".ui.MapsActivity"
                android:theme="@style/AppTheme"
                android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

			<!-- Attach only: detach is delivered to runtime-registered
			     receivers, never through an activity filter — a DETACHED
			     entry here did nothing but offer a way to launch. -->
			<intent-filter>
				<action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
			</intent-filter>
			<!-- Named for what it filters, not just "device_filter": the UVC
			     video library ships a res/xml/device_filter of its own, and
			     an app file by the same name would override it — the camera
			     watcher would then be reading this serial filter. -->
			<meta-data
				android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
				android:resource="@xml/usb_serial_device_filter" />

        </activity>
        <activity
                android:label="Settings"
                android:name=".ui.SettingsActivity"
                android:theme="@style/AppTheme"/>
        <activity android:name=".ui.SensorsActivity"/>

        <service android:name=".service.DataService"/>



    </application>

</manifest>
